# App
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="Hearts & Beans"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SUPPORT_EMAIL="support@heartsandbeans.in"
NEXT_PUBLIC_SUPPORT_PHONE="+919999999999"
NEXT_PUBLIC_WHATSAPP_NUMBER="+919999999999"
NEXT_PUBLIC_INSTAGRAM_URL="https://www.instagram.com/heartsandbeans"

# PostgreSQL on Supabase
DATABASE_URL="postgresql://postgres:postgres@localhost:55432/heart_and_beans?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:55432/heart_and_beans?schema=public"

# NextAuth v5
AUTH_SECRET="replace-with-a-32-character-random-secret"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
AUTH_GOOGLE_ID="replace-with-google-client-id"
AUTH_GOOGLE_SECRET="replace-with-google-client-secret"
ADMIN_EMAILS="admin@heartsandbeans.in"

# Upstash Redis
UPSTASH_REDIS_REST_URL="https://example.upstash.io"
UPSTASH_REDIS_REST_TOKEN="replace-with-upstash-token"

# Cloudflare R2
CLOUDFLARE_R2_ACCOUNT_ID="replace-with-account-id"
CLOUDFLARE_R2_ACCESS_KEY_ID="replace-with-access-key"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="replace-with-secret-key"
CLOUDFLARE_R2_BUCKET_NAME="hearts-and-beans-uploads"
CLOUDFLARE_R2_PUBLIC_BASE_URL="https://pub-example.r2.dev"

# Razorpay
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_replace"
RAZORPAY_KEY_ID="rzp_test_replace"
RAZORPAY_KEY_SECRET="replace-with-razorpay-secret"
RAZORPAY_WEBHOOK_SECRET="replace-with-webhook-secret"

# Resend
RESEND_API_KEY="re_replace"
RESEND_FROM_EMAIL="Hearts & Beans <orders@heartsandbeans.in>"
RESEND_AUDIENCE_ID="replace-with-audience-id"

# WATI WhatsApp
WATI_API_BASE_URL="https://live-server-12345.wati.io"
WATI_ACCESS_TOKEN="replace-with-wati-token"
WATI_BROADCAST_NAME="hearts_and_beans_order_updates"

# Inngest
INNGEST_EVENT_KEY="replace-with-inngest-event-key"
INNGEST_SIGNING_KEY="replace-with-inngest-signing-key"

# Analytics and monitoring
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
NEXT_PUBLIC_META_PIXEL_ID="123456789012345"
META_PIXEL_ID="123456789012345"
META_CONVERSIONS_ACCESS_TOKEN="replace-with-meta-token"
META_TEST_EVENT_CODE=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# Operational limits
UPLOAD_MAX_FILES="35"
UPLOAD_MAX_FILE_SIZE_BYTES="10485760"
PARTIAL_COD_ADVANCE_PAISE="12000"
PARTIAL_COD_FEE_PAISE="12000"
FREE_SHIPPING_THRESHOLD_PAISE="99900"
DEFAULT_SHIPPING_FEE_PAISE="7900"
RATE_LIMIT_REQUESTS_PER_MINUTE="120"
